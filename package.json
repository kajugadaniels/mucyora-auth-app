{
  "name": "mucyora-auth-app",
  "version": "0.1.0",
  "private": true,
  "description": "Secure, accessible authentication frontend and same-origin Auth gateway for MUCYORA",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "next dev --webpack -p 4000",
    "start": "next start -p 4000",
    "build": "next build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "check:structure": "node scripts/assert-project-boundary.mjs",
    "check:no-gradients": "node scripts/assert-no-gradients.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check": "npm run check:structure && npm run check:no-gradients && npm run check:contrast && npm run lint && npm run typecheck",
    "clean": "node scripts/clean.mjs",
    "release:check": "npm run check && npm run build",
    "preview": "npm run start"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.2.3",
    "@hugeicons/react": "^1.1.9",
    "lucide-react": "1.27.0",
    "next": "^16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.62.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.2.12",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "nanoid": "3.3.18"
  }
}
